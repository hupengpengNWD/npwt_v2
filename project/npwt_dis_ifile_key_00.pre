void get_xx_delta(unsigned short press)
{
unsigned short delta = 8;
if (press<20)
{
delta = 2;
con_hi_delta = 2;
}
else if (press >= 80)
{
delta = press/20;
con_hi_delta = delta*15/10;
}
else
{
delta = press/10;
con_hi_delta = delta*17/10;
}
con_lo_delta = delta;
con_hi_delta = delta;

}

