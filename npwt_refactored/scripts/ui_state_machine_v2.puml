@startuml UI状态机转换图V2

title UI状态机转换图V2

state "系统初始化\nSYS" as SYS
state "待机模式\nWAT" as WAT
state "连续工作模式\nLIX" as LIX
state "间歇工作模式\nJIX" as JIX
state "暂停模式\nZHT" as ZHT
state "设置模式\nSET" as SET
state "连续模式压力设置\nSET_PRESSURE" as SET_PRESSURE
state "间歇模式高压设置\nSET_HP_PRESSURE" as SET_HP_PRESSURE
state "间歇模式低压设置\nSET_LP_PRESSURE" as SET_LP_PRESSURE
state "间歇模式时间设置\nSET_TIME" as SET_TIME

[*] --> SYS

' [0] SYS -> WAT (TIMEOUT)
SYS --> WAT : TIMEOUT\n(超时)

' [1] WAT -> SET (MENU_UP)
WAT --> SET : MENU_UP\n(菜单向上)

' [2] WAT -> LIX (CONFIRM_LONG)
WAT --> LIX : CONFIRM_LONG\n(长按电源键释放)
WAT --> JIX : CONFIRM_LONG\n(长按电源键释放)
' [3] LIX -> ZHT (CONFIRM_LONG)
LIX --> ZHT : CONFIRM_LONG\n(确认键长按释放)
LIX --> WARING : 漏气\n液位满\n阻塞\n
' [4] JIX -> ZHT (CONFIRM_LONG)
JIX --> ZHT : CONFIRM_LONG\n(确认键长按释放)
JIX --> WARING : 漏气\n液位满\n阻塞\n
' [5] ZHT -> SET (MENU_UP)
ZHT --> SET : MENU_UP\n(向上方向键长按释放)
WARING --> ZHT : CONFIRM_LONG\n(确认键长按释放)
' [6] ZHT -> LIX/JIX (CONFIRM_LONG, 根据work_mode_backup)
ZHT --> LIX : CONFIRM_LONG\n(恢复治疗-连续)
ZHT --> JIX : CONFIRM_LONG\n(恢复治疗-间歇)

' [7] SET -> SET (MENU_UP, 切换工作模式)
SET --> SET : MENU_UP\n(切换工作模式)

' [8] SET -> SET (MENU_DOWN, 切换工作模式)
SET --> SET : MENU_DOWN\n(切换工作模式)

' [9] SET -> SET_PRESSURE (CONFIRM_LONG, 连续模式)
SET --> SET_PRESSURE : CONFIRM_LONG\n(连续模式)

' [10] SET -> SET_HP_PRESSURE (CONFIRM, 间歇模式)
SET --> SET_HP_PRESSURE : CONFIRM\n(间歇模式)

' [11] SET_PRESSURE -> SET_PRESSURE (MENU_UP, 增加压力)
SET_PRESSURE --> SET_PRESSURE : MENU_UP\n(增加压力)

' [12] SET_PRESSURE -> SET_PRESSURE (MENU_DOWN, 减少压力)
SET_PRESSURE --> SET_PRESSURE : MENU_DOWN\n(减少压力)

' [13] SET_PRESSURE -> ZHT (CONFIRM_LONG)
SET_PRESSURE --> ZHT : CONFIRM_LONG\n(确认键长按释放)

' [14] SET_HP_PRESSURE -> SET_HP_PRESSURE (MENU_UP, 增加高压)
SET_HP_PRESSURE --> SET_HP_PRESSURE : MENU_UP\n(增加高压)

' [15] SET_HP_PRESSURE -> SET_HP_PRESSURE (MENU_DOWN, 减少高压)
SET_HP_PRESSURE --> SET_HP_PRESSURE : MENU_DOWN\n(减少高压)

' [16] SET_HP_PRESSURE -> SET_LP_PRESSURE (CONFIRM_LONG)
SET_HP_PRESSURE --> SET_LP_PRESSURE : CONFIRM_LONG\n(确认键长按释放)

' [17] SET_LP_PRESSURE -> SET_LP_PRESSURE (MENU_UP, 增加低压)
SET_LP_PRESSURE --> SET_LP_PRESSURE : MENU_UP\n(增加低压)

' [18] SET_LP_PRESSURE -> SET_LP_PRESSURE (MENU_DOWN, 减少低压)
SET_LP_PRESSURE --> SET_LP_PRESSURE : MENU_DOWN\n(减少低压)

' [19] SET_LP_PRESSURE -> SET_TIME (CONFIRM_LONG)
SET_LP_PRESSURE --> SET_TIME : CONFIRM_LONG\n(确认键长按释放)

' [20] SET_TIME -> SET_TIME (MENU_UP, 增加时间)
SET_TIME --> SET_TIME : MENU_UP\n(增加时间)

' [21] SET_TIME -> SET_TIME (MENU_DOWN, 减少时间)
SET_TIME --> SET_TIME : MENU_DOWN\n(减少时间)

' [22] SET_TIME -> SET_TIME (CONFIRM_LONG, 切换编辑项)
SET_TIME --> SET_TIME : CONFIRM_LONG\n(切换编辑项\n高压时间/低压时间)

' [23] SET_TIME -> ZHT (CONFIRM, 完成设置)
SET_TIME --> ZHT : CONFIRM\n(完成设置)

' [24] SET -> SET (LANGUAGE_SWITCH, 切换语言)
SET --> SET : LANGUAGE_SWITCH\n(OK+CANCEL\n切换语言)

note right of SYS
  系统启动时的初始状态
  显示开机Logo和版本号
end note

note right of WAT
  等待用户指令
  可以进入设置或启动治疗
  长按电源键进入连续模式
end note

note left of SET
  模式选择界面
  可以切换连续/间歇模式
  支持语言切换(OK+CANCEL)
end note

note right of ZHT
  暂停模式
  可以恢复治疗或进入设置
  恢复时根据work_mode_backup
  决定进入连续或间歇模式
end note

note right of SET_PRESSURE
  连续模式压力设置
  使用MENU_UP/DOWN调整
  CONFIRM_LONG确认并退出
end note

note left of SET_HP_PRESSURE
  间歇模式高压设置
  使用MENU_UP/DOWN调整
  CONFIRM_LONG进入低压设置
end note

note left of SET_LP_PRESSURE
  间歇模式低压设置
  使用MENU_UP/DOWN调整
  CONFIRM_LONG进入时间设置
end note

note left of SET_TIME
  间歇模式时间设置
  使用MENU_UP/DOWN调整
  CONFIRM_LONG切换编辑项
  CONFIRM完成设置
end note

@enduml

